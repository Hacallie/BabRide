# Copy to .env.local (local) or set in your host's dashboard (deployment). Placeholders only. Never commit real values.
# If a required variable is missing or still a placeholder, Bab Ride refuses to run data APIs and shows a red banner.

# --- Required: Supabase (use a separate project for development, testing and production) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Required in production, optional locally ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional ---
# Minutes before an unaccepted request expires (whole number, default 10)
BABRIDE_SEARCH_TIMEOUT_MIN=10
# Largest group one booking may carry (1 to 8, default 3 = the vehicles.capacity database default). Each rider's own
# administrator-confirmed seat capacity is still enforced when they accept. The fare is per RIDE, never per passenger.
BABRIDE_MAX_PASSENGERS=3
# How the service area is decided. "boundary" (default, strict): no fare until a real campus polygon is saved in the database.
# "landmarks": two different active landmarks are an eligible trip without a polygon (GPS pickups still need one).
# Choose "landmarks" only as a deliberate decision. Distance never changes the fare either way.
BABRIDE_SERVICE_AREA=boundary

# --- Sign-in: Google + email/password only. This public on/off flag is NOT a secret. Set it to true ONLY after the Google provider is
# configured in Supabase. The redirect URL is built from the current origin, so localhost and production each work without edits here.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
# Email delivery (SMTP) and the Google client secret are entered in the Supabase dashboard, not here.

# --- Optional: admin landmark place search (server-side; NOT secrets). Off by default. ---
# "nominatim" uses OpenStreetMap's public search (no API key; light use only, per its usage policy). A contact address is REQUIRED
# by that policy and is sent in the User-Agent. Without GEOCODER_CONTACT the search stays off. Leave "none" to use GPS only.
GEOCODER_PROVIDER=none
GEOCODER_CONTACT=
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# Searches are first asked with this text added so results favour the campus (default shown). Never coordinates.
GEOCODER_CONTEXT=Babcock University, Ilishan-Remo
# Optional rough campus rectangle YOU supply, "west,south,east,north" in degrees, to prefer results inside it. Leave empty if unsure.
GEOCODER_VIEWBOX=

# --- Reserved for later Phase 4 steps. NOT read or validated yet. ---
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
