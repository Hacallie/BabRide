# Copy to .env.local (local) or set in your host's dashboard (deployment). Placeholders only. Never commit real values.
# If a required variable is missing or still a placeholder, Bab Ride refuses to run data APIs and shows a red banner.

# --- Required: Supabase (use a separate project for development, testing and production) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Required in production, optional locally ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional ---
# Minutes before an unaccepted request expires (whole number, default 10)
BABRIDE_SEARCH_TIMEOUT_MIN=10

# --- Optional sign-in buttons (public on/off flags, NOT secrets). Set to true ONLY after the provider is configured in Supabase. ---
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
# Email delivery (Brevo SMTP) and Google/Apple client secrets are entered in the Supabase dashboard, not here.

# --- Optional: admin landmark place search (server-side; NOT secrets). Off by default. ---
# "nominatim" uses OpenStreetMap's public search (no API key; light use only, per its usage policy). A contact address is REQUIRED
# by that policy and is sent in the User-Agent. Without GEOCODER_CONTACT the search stays off. Leave "none" to use GPS only.
GEOCODER_PROVIDER=none
GEOCODER_CONTACT=
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# --- Reserved for later Phase 4 steps. NOT read or validated yet. ---
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
